# PostgreSQL (Docker)
POSTGRES_USER=pokyplane
POSTGRES_PASSWORD=pokyplane_secret
POSTGRES_DB=pokyplane
POSTGRES_PORT=5444
DATABASE_URL=postgresql://pokyplane:pokyplane_secret@localhost:5444/pokyplane

# API + admin panel
PORT=7777
NODE_ENV=development
CLIENT_ORIGIN=http://localhost
# On Liara set CLIENT_ORIGIN to your app URL, e.g. https://pokyplane.liara.run

# Game (Vite dev/preview)
VITE_GAME_PORT=80

# JWT — change in production!
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Default admin (created on first migrate if missing)
ADMIN_EMAIL=admin@pokyplane.local
ADMIN_PASSWORD=Admin123!
ADMIN_USERNAME=admin
